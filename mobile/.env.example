# Project identity
PROJECT_NAME=Project Template
BASE_URL=http://127.0.0.1:8000/api/v1

# Native Google sign-in
# Use the Google OAuth web/server client ID that is allowed to mint ID tokens
# for your mobile app and accepted by the backend social login endpoint.
GOOGLE_SERVER_CLIENT_ID=

# Analytics
# Mobile .env is for startup-safe, non-secret defaults only.
ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=posthog
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
